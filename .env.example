# Local persona demo. The API refuses this mode on a public bind address or in production.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3001
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080

OPENFGA_API_URL=http://127.0.0.1:8081
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_CLIENT_ID=
OPENFGA_CLIENT_SECRET=
OPENFGA_TOKEN_ISSUER=
OPENFGA_AUDIENCE=

# Optional Auth0 mode: signed API access tokens are verified on the server.
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=
AUTH0_FGA_USER_CLAIM=sub
AUTH_USER_PROFILES={}
AUTH_OPENFGA_API_URL=http://127.0.0.1:8081
AUTH_OPENFGA_STORE_ID=
AUTH_OPENFGA_AUTHORIZATION_MODEL_ID=
AUTH_OPENFGA_CLIENT_ID=
AUTH_OPENFGA_CLIENT_SECRET=
AUTH_OPENFGA_TOKEN_ISSUER=
AUTH_OPENFGA_AUDIENCE=

# Optional, server-only. Never use VITE_ for a service credential.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Public client configuration; these values are safe to include in a browser.
VITE_API_URL=http://127.0.0.1:3001
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_FGA_USER_CLAIM=sub
